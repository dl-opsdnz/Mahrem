{
  "name": "mahrem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "dev:static": "pnpm dev",
    "build": "vite build",
    "build:static": "pnpm build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "check": "tsc --noEmit",
    "format": "prettier --write app.config.ts client/src client/index.html vite.config.ts vitest.config.ts README.md README.tr.md PRIVACY.md SECURITY.md CONTRIBUTING.md TODO.md",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "pnpm": "10.18.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.18.0"
}
